# Copie este arquivo para .env e ajuste os valores. O .env nunca é commitado.

# Postgres
POSTGRES_DB=moon
POSTGRES_USER=moon
POSTGRES_PASSWORD=

# MinIO
MINIO_ROOT_USER=moon
MINIO_ROOT_PASSWORD=

# Backend (Moon.Api)
CONNECTION_STRING_DEFAULT=Host=localhost;Port=5432;Database=moon;Username=moon;Password=
JWT_KEY=
JWT_ISSUER=moon-api
JWT_AUDIENCE=moon-app
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
FRONTEND_ORIGIN=http://localhost:5001

# Backend (Moon.Api) — painel admin (auth totalmente separada da do cliente)
ADMIN_JWT_KEY=
ADMIN_JWT_ISSUER=moon-admin-api
ADMIN_JWT_AUDIENCE=moon-admin-app
ADMIN_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
ADMIN_JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_FRONTEND_ORIGIN=http://localhost:5003
# Só usadas uma vez, pra criar o primeiro admin (a tabela nasce vazia). Pode remover do
# .env depois que ele existir.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
